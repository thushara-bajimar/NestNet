<% layout("./layouts/boilerplate") %>
<br><br>
<h3>Create a New Listing</h3>
<br><br>
<form action="/listings" method="post">
  <div>
    <label for="sizesInputLarge" class="form-label">Title: </label
    ><input
      class="form-control form-control-lg"
      type="text"
      id="title"
      name="listing[title]"
      placeholder="Enter Title"
      required
    />
  </div>
  <br />
  <div>
    <label for="sizesInputLarge" class="form-label">Image URL: </label
    ><input
      class="form-control form-control-lg"
      type="text"
      id="image"
      name="listing[image]"
      placeholder="Enter Image URL"
      required
    />
  </div>
  <br />
  <div>
    <label for="sizesTextareaLarge" class="form-label">Description: </label
    ><textarea
      class="form-control form-control-lg"
      id="description"
      name="listing[description]"
      placeholder="Enter Description"
      required
    ></textarea>
  </div>
  <br />
  <div class="row">
    <div class="col-4">
      <label for="sizesInputLarge" class="form-label">Price: </label
      ><input
        class="form-control form-control-lg"
        type="number"
        id="price"
        name="listing[price]"
        step="0.01"
        placeholder="&#8377;5000"
        required
      />
    </div>
    <!-- <br /> -->
    <div class="col-8">
      <label for="sizesInputLarge" class="form-label">Country: </label
      ><input
        class="form-control form-control-lg"
        type="text"
        id="country"
        name="listing[country]"
        placeholder="India"
        required
      />
    </div>
  </div>
  <br />
  <div>
    <label for="sizesInputLarge" class="form-label">Location: </label
    ><input
      class="form-control form-control-lg"
      type="text"
      id="location"
      name="listing[location]"
      placeholder="Bengaluru, Karnataka"
      required
    />
  </div>
  <br><br>

  <div>
    <button type="submit" class="sub-btn btn btn-coral ms-md-3">
      Create Listing
    </button>
  </div>
</form>
<br><br>
