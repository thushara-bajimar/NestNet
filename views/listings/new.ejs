<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NestNet</title>
</head>
<body>
    <h3>Create New Listing</h3>
    <form action="/listings" method="post">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="listing[title]" required>
        </div>
        <br>
        <div>
            <label for="image">Image URL:</label>
            <input type="text" id="image" name="listing[image]" required>
        </div>
        <br>
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="listing[description]" required></textarea>
        </div>
        <br>
        <div>
            <label for="price">Price:</label>
            <input type="number" id="price" name="listing[price]" step="0.01" required>
        </div>
        <br>
        <div>
            <label for="location">Location:</label>
            <input type="text" id="location" name="listing[location]" required>
        </div>
        <br>
        <div>
            <label for="country">Country:</label>
            <input type="text" id="country" name="listing[country]" required>
        </div>
        <br>
        <button type="submit">Create Listing</button>
    </form>
</body>
</html>