<% layout("./layouts/boilerplate") %>

<section class="listing-show" aria-labelledby="listing-title">
  <article class="card listing-show__card">
    <img
      src="<%= listing.image %>"
      alt="<%= listing.title %>"
      class="listing-show__image"
    />

    <div class="card-body listing-show__content">
      <h1 id="listing-title" class="listing-show__title"><%= listing.title %></h1>
      <p class="listing-show__description"><%= listing.description %></p>

      <dl class="listing-show__details">
        <div class="listing-show__detail">
          <dt>Price</dt>
          <dd>&#8377;<%= listing.price.toLocaleString("en-IN") %></dd>
        </div>
        <div class="listing-show__detail">
          <dt>Location</dt>
          <dd><%= listing.location %></dd>
        </div>
        <div class="listing-show__detail">
          <dt>Country</dt>
          <dd><%= listing.country %></dd>
        </div>
      </dl>

      <div class="listing-show__actions">
        <a class="btn sub-btn" href="/listings/<%= listing._id %>/edit">Edit listing</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
          <button type="submit" class="btn listing-show__delete">Delete listing</button>
        </form>
      </div>
    </div>
  </article>
</section>
